{
  "name": "instat-services",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Microservices du portail INSTAT (Auth, Publications, Madagascar en chiffres, Fichiers).",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc",
    "dev:auth": "node --watch auth/src/server.ts",
    "dev:publications": "node --watch publications/src/server.ts",
    "dev:chiffres": "node --watch chiffres/src/server.ts",
    "dev:files": "node --watch files/src/server.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.6",
    "fastify": "^5.12.7",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}
