{
  "name": "instat-services",
  "private": true,
  "version": "0.2.0",
  "description": "Microservices NestJS du portail INSTAT : auth, publications, chiffres, files.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "nest build auth && nest build publications && nest build chiffres && nest build files",
    "build:auth": "nest build auth",
    "build:publications": "nest build publications",
    "build:chiffres": "nest build chiffres",
    "build:files": "nest build files",
    "start:auth": "nest start auth --watch",
    "start:publications": "nest start publications --watch",
    "start:chiffres": "nest start chiffres --watch",
    "start:files": "nest start files --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules --no-warnings=ExperimentalWarning node_modules/jest/bin/jest.js"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.6",
    "@fastify/static": "^10.1.8",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-fastify": "^12.3.2",
    "@nestjs/swagger": "^12.0.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.11",
    "@nestjs/testing": "^12.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.5.4",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "~6.0.3",
    "webpack": "^5.105.4",
    "webpack-node-externals": "^3.0.0"
  },
  "jest": {
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "moduleNameMapper": {
      "^@app/common(|/.*)$": "<rootDir>/libs/common/src$1"
    },
    "testEnvironment": "node"
  }
}
