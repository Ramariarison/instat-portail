# Copier en .env.local pour changer les réglages du front (lus au build par Vite).

# Adresse de la passerelle d'API vue par le navigateur (par défaut /api, même origine).
# VITE_API_URL=/api

# Cible du proxy /api de `npm run dev` (la passerelle de docker compose).
# VITE_API_PROXY=http://localhost:8080

# true : la page d'accueil utilise les données d'exemple de src/data, sans back-end.
# VITE_SAMPLE_DATA=false

# Comptes de démonstration dans la fenêtre de connexion (par défaut : oui en dev, non en build).
# VITE_SHOW_DEMO_ACCOUNTS=true
