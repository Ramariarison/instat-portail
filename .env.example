# Copier ce fichier en .env (cp .env.example .env) puis changer TOUS les secrets hors du poste de développement.

# Port local de la passerelle (site + API) : http://localhost:8080
GATEWAY_PORT=8080

# Secret de signature des jetons JWT, partagé par tous les services (32 caractères minimum).
# Générer : openssl rand -hex 32
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
JWT_TTL_SECONDS=28800

# PostgreSQL : super-utilisateur, puis un rôle et une base par service.
# Ces mots de passe ne servent qu'à la création du volume : les changer ensuite demande un ALTER ROLE.
POSTGRES_PASSWORD=dev-postgres
AUTH_DB_PASSWORD=dev-auth
PUBLICATIONS_DB_PASSWORD=dev-publications
CHIFFRES_DB_PASSWORD=dev-chiffres

# Données d'exemple et comptes de démonstration (mot de passe demo1234). false en production.
SEED_DEMO=true

# Premier super administrateur (production) : créé au démarrage s'il n'en existe aucun.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Origine autorisée en CORS (serveur de développement Vite du front).
CORS_ORIGIN=http://localhost:5173

LOG_LEVEL=info

# pgAdmin (outil de développement) : docker compose --profile outils up -d → http://localhost:5050
PGADMIN_PORT=5050
